{
  "manifest_version": 3,
  "name": "Bigshoot — Chụp theo element",
  "short_name": "Bigshoot",
  "version": "1.0.0",
  "description": "Chụp toàn bộ một element, vùng cuộn hoặc cả trang chỉ bằng một cú nhấp.",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "debugger",
    "downloads",
    "offscreen",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Chọn element để chụp",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
