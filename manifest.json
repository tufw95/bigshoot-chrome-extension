{
  "manifest_version": 3,
  "name": "Bigshoot - Element Screenshots",
  "short_name": "Bigshoot",
  "version": "1.0.3",
  "description": "Capture an entire element, scrollable region, or full page with one click.",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "debugger",
    "downloads",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Select an element to capture",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+6",
        "mac": "Command+Shift+6"
      },
      "description": "Start selecting an element to capture"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
